# macOS
.DS_Store
**/.DS_Store

# IDE/local editor state
.idea/

# Python/cache artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local-only data and generated outputs
local_only/
outputs/
tmp/
temp/
logs/
screenshots/
verification_screens/
**/outputs/
**/tmp/
**/temp/
**/logs/
**/screenshots/
**/verification_screens/

# Real business exports and raw data
*.xlsx
*.xls
*.xlsm
*.csv
*.tsv
*.parquet
*.jsonl
*.zip
*.rar
*.7z
*.pdf

# Temporary developer-review rule import package.
# Keep this visible in Git only while the first import package is under review.
# After review, move it back to local_only/ or another non-Git delivery channel.
!03_data_contracts/rule_tables/import_ready/
!03_data_contracts/rule_tables/import_ready/**
!03_data_contracts/rule_tables/import_ready/**/*.csv
!03_data_contracts/rule_tables/import_ready/**/*.xlsx
!03_data_contracts/rule_tables/import_ready/**/*.json
!03_data_contracts/rule_tables/import_ready/**/*.md
!03_data_contracts/rule_tables/import_ready/**/*.png

# Legacy development-review spreadsheets kept as archive source files.
!archive/development_review/2026-09-08_legacy_development_review/*.xlsx

# SQL or database dumps
*.sql
*.dump
*.bak

# Office temporary lock files
~$*
.~*

# Environment files
.env
.env.*
